# EMAIL CONFIGURATION
# Opción 1: Gmail (recomendado para desarrollo)
# 1. Ve a: https://myaccount.google.com/apppasswords
# 2. Selecciona "Mail" y "Windows"
# 3. Copia la contraseña de 16 caracteres y pégala aquí

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu@gmail.com
SMTP_PASS=tu-password-de-16-caracteres

# Opción 2: Otros proveedores
# SMTP_HOST: el servidor SMTP de tu proveedor
# SMTP_PORT: normalmente 587 (TLS) o 465 (SSL)
# SMTP_SECURE: true si usas puerto 465 (SSL), false si usas 587 (TLS)
# SMTP_USER: tu correo o usuario SMTP
# SMTP_PASS: tu contraseña SMTP
